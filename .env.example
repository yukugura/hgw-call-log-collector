# HGW Web設定
HGW_IP=192.168.0.1
HGW_SCHEME=http
# HGW Web設定のHTTP Basic認証
HGW_BASIC_AUTH_USER=user
# HGW_BASIC_AUTH_PASSWORD=HGWの「機器設定用パスワード」
HGW_BASIC_AUTH_PASSWORD=

# このHGWの「情報 > 通話ログ」。完全URLも指定できます。
HGW_CALL_LOG_URL=/cgi-bin/mainte.cgi?st_clog
HGW_TIMEOUT_SECONDS=10

# MySQL
MYSQL_HOST=192.168.0.2
MYSQL_PORT=3306
MYSQL_DATABASE=hgw_call_logs
MYSQL_USER=hgwlog
MYSQL_PASSWORD=

# 任意: ログに電話番号を出したくない場合は false
LOG_PHONE_NUMBERS=false
